{
  "name": "srfab",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "srfab",
      "database_id": "aba2d847-9726-4366-ad1b-3cf1240469e8"
    }
  ]
}
